apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: security-gateway
  namespace: {{ namespace }}
spec:
  gatewayClassName: nginx
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: Same
{% for fn in functions %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ fn.name }}
  namespace: {{ namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ fn.name }}
  template:
    metadata:
      labels:
        app: {{ fn.name }}
    spec:
      containers:
        - name: {{ fn.name }}
          image: {{ fn.image }}
          ports:
{% for p in fn.ports %}
            - containerPort: {{ p }}
{% endfor %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ fn.name }}
  namespace: {{ namespace }}
spec:
  selector:
    app: {{ fn.name }}
  ports:
    - name: tcp
      port: 80
      targetPort: {{ fn.ports[0] }}
{% endfor %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: security-chain-http
  namespace: {{ namespace }}
spec:
  parentRefs:
    - name: security-gateway
  hostnames: ["demo.local"]
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
{% for hop in chain_order %}
        - name: {{ hop }}
          port: 80
{% endfor %}
---
apiVersion: gateway.networking.k8s.io/v1alpha2
kind: TCPRoute
metadata:
  name: security-chain-tcp
  namespace: {{ namespace }}
spec:
  parentRefs:
    - name: security-gateway
  rules:
    - backendRefs:
{% for hop in chain_order %}
        - name: {{ hop }}
          port: 80
{% endfor %}
