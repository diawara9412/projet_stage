# Clé API Groq pour les LLM Llama (obtenir sur https://console.groq.com)
GROQ_API_KEY=

# Clé API ipinfo pour la vérification des IP (optionnelle)
IPINFO_API_KEY=

# Configuration du logging
LOG_LEVEL=INFO

# Configuration des agents
MAX_ITERATIONS=3
SUPERVISOR_MODEL=llama-3.3-70b-versatile
WORKER_MODEL=llama-3.3-70b-versatile
SUPERVISOR_TEMPERATURE=0.2
WORKER_TEMPERATURE=0.4
